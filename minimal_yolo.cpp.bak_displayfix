#include <gst/gst.h>
#include <glib.h>
#include <stdio.h>
#include <string.h>
#include "gstnvdsmeta.h"

static gboolean bus_call(GstBus *bus, GstMessage *msg, gpointer data) {
    GMainLoop *loop = (GMainLoop *)data;
    switch (GST_MESSAGE_TYPE(msg)) {
        case GST_MESSAGE_EOS:
            g_print("\n=== End of stream ===\n");
            g_main_loop_quit(loop);
            break;
        case GST_MESSAGE_ERROR: {
            gchar *debug = NULL;
            GError *error = NULL;
            gst_message_parse_error(msg, &error, &debug);
            g_printerr("ERROR from %s: %s\n", GST_OBJECT_NAME(msg->src), error ? error->message : "unknown");
            if (debug) g_printerr("Debug: %s\n", debug);
            g_free(debug);
            if (error) g_error_free(error);
            g_main_loop_quit(loop);
            break;
        }
        default: break;
    }
    return TRUE;
}

// qtdemux creates pads dynamically; link only the video pad to h264parse
static void on_pad_added(GstElement *src, GstPad *new_pad, gpointer data) {
    GstElement *h264parser = (GstElement *)data;
    GstPad *sink_pad = gst_element_get_static_pad(h264parser, "sink");
    if (!sink_pad) return;

    GstCaps *caps = gst_pad_get_current_caps(new_pad);
    if (!caps) caps = gst_pad_query_caps(new_pad, NULL);

    if (caps) {
        GstStructure *str = gst_caps_get_structure(caps, 0);
        const gchar *name = gst_structure_get_name(str);
        // g_print("DEMUX pad-added caps: %s\n", name);

        if (g_str_has_prefix(name, "video/")) {
            if (!gst_pad_is_linked(sink_pad)) {
                if (gst_pad_link(new_pad, sink_pad) != GST_PAD_LINK_OK) {
                    g_printerr("ERROR: Failed to link demux video pad to h264parse\n");
                }
            }
        }
        gst_caps_unref(caps);
    }

    gst_object_unref(sink_pad);
}

static GstPadProbeReturn osd_sink_pad_buffer_probe(GstPad *pad, GstPadProbeInfo *info, gpointer u_data) {
    GstBuffer *buf = (GstBuffer *)info->data;
    NvDsBatchMeta *batch_meta = gst_buffer_get_nvds_batch_meta(buf);
    if (!batch_meta) return GST_PAD_PROBE_OK;

    for (NvDsMetaList *l_frame = batch_meta->frame_meta_list; l_frame != NULL; l_frame = l_frame->next) {
        NvDsFrameMeta *frame_meta = (NvDsFrameMeta *)(l_frame->data);
        if (!frame_meta) continue;

        int obj_count = 0;
        for (NvDsMetaList *l_obj = frame_meta->obj_meta_list; l_obj != NULL; l_obj = l_obj->next) obj_count++;

        g_print("\n--- Frame %d: %d objects detected ---\n", frame_meta->frame_num, obj_count);

        for (NvDsMetaList *l_obj = frame_meta->obj_meta_list; l_obj != NULL; l_obj = l_obj->next) {
            NvDsObjectMeta *obj_meta = (NvDsObjectMeta *)(l_obj->data);
            g_print("  Class: %-12s | Confidence: %5.2f%% | BBox: [%4.0f, %4.0f, %4.0f, %4.0f]\n",
                obj_meta->obj_label,
                obj_meta->confidence * 100.0f,
                obj_meta->rect_params.left,
                obj_meta->rect_params.top,
                obj_meta->rect_params.left + obj_meta->rect_params.width,
                obj_meta->rect_params.top + obj_meta->rect_params.height);
        }
    }
    return GST_PAD_PROBE_OK;
}

int main(int argc, char *argv[]) {
    GMainLoop *loop = NULL;
    GstElement *pipeline = NULL, *source = NULL, *demux = NULL, *h264parser = NULL,
               *decoder = NULL, *cpuconv = NULL, *pre_nvconv = NULL, *pre_caps = NULL,
               *streammux = NULL, *pgie = NULL, *post_nvconv = NULL, *post_caps = NULL,
               *nvosd = NULL, *sink = NULL;

    GstBus *bus = NULL;
    guint bus_watch_id = 0;

    gst_init(&argc, &argv);
    loop = g_main_loop_new(NULL, FALSE);

    if (argc != 3) {
        g_printerr("Usage: %s <video_file> <config_file>\n", argv[0]);
        return -1;
    }

    g_print("\n=== Minimal YOLO Detection App ===\n");
    g_print("Video: %s\n", argv[1]);
    g_print("Config: %s\n\n", argv[2]);
    g_print("Running in WSL\n");

    pipeline   = gst_pipeline_new("yolo-pipeline");
    source     = gst_element_factory_make("filesrc", "file-source");
    demux      = gst_element_factory_make("qtdemux", "qtdemux");
    h264parser = gst_element_factory_make("h264parse", "h264-parser");

    // CPU decode (works without /dev/nvidia0)
    decoder    = gst_element_factory_make("avdec_h264", "h264-decoder");
    cpuconv    = gst_element_factory_make("videoconvert", "cpu-converter");

    // Upload/convert into NVMM for nvstreammux
    pre_nvconv = gst_element_factory_make("nvvideoconvert", "pre-nvvideo-converter");
    pre_caps   = gst_element_factory_make("capsfilter", "pre-caps");

    streammux  = gst_element_factory_make("nvstreammux", "stream-muxer");
    pgie       = gst_element_factory_make("nvinfer", "primary-nvinference-engine");
    post_nvconv= gst_element_factory_make("nvvideoconvert", "post-nvvideo-converter");
    post_caps  = gst_element_factory_make("capsfilter", "post-caps");
    nvosd      = gst_element_factory_make("nvdsosd", "nv-onscreendisplay");

    // Keep fakesink for now (display in WSL is a separate step)
    sink       = gst_element_factory_make("ximagesink", "x11-sink");

    if (!pipeline || !source || !demux || !h264parser || !decoder || !cpuconv ||
        !pre_nvconv || !pre_caps || !streammux || !pgie || !post_nvconv || !post_caps ||
        !nvosd || !sink) {
        g_printerr("ERROR: One or more elements could not be created\n");
        return -1;
    }

    // properties
    g_object_set(G_OBJECT(source), "location", argv[1], NULL);
    g_object_set(G_OBJECT(streammux), "width", 1920, "height", 1080,
                 "batch-size", 1, "batched-push-timeout", 4000000, NULL);
    g_object_set(G_OBJECT(pgie), "config-file-path", argv[2], NULL);
    g_object_set(G_OBJECT(sink), "sync", FALSE, NULL);

    // caps: make sure we feed nvstreammux NVMM surfaces
    GstCaps *caps_pre = gst_caps_from_string("video/x-raw(memory:NVMM), format=NV12");
    g_object_set(G_OBJECT(pre_caps), "caps", caps_pre, NULL);
    gst_caps_unref(caps_pre);

    // nvdsosd expects RGBA
    GstCaps *caps_post = gst_caps_from_string("video/x-raw(memory:NVMM), format=RGBA");
    g_object_set(G_OBJECT(post_caps), "caps", caps_post, NULL);
    gst_caps_unref(caps_post);

    // bus
    bus = gst_pipeline_get_bus(GST_PIPELINE(pipeline));
    bus_watch_id = gst_bus_add_watch(bus, bus_call, loop);
    gst_object_unref(bus);

    // add elements
    gst_bin_add_many(GST_BIN(pipeline),
        source, demux, h264parser, decoder, cpuconv, pre_nvconv, pre_caps,
        streammux, pgie, post_nvconv, post_caps, nvosd, sink, NULL);

    // link: filesrc -> demux (dynamic pads) -> h264parse -> avdec -> videoconvert -> nvvideoconvert -> caps
    if (!gst_element_link(source, demux)) {
        g_printerr("ERROR: Failed to link source->demux\n");
        return -1;
    }
    g_signal_connect(demux, "pad-added", G_CALLBACK(on_pad_added), h264parser);

    if (!gst_element_link_many(h264parser, decoder, cpuconv, pre_nvconv, pre_caps, NULL)) {
        g_printerr("ERROR: Failed to link h264parser->decoder->cpuconv->pre_nvconv->pre_caps\n");
        return -1;
    }

    // link pre_caps -> streammux sink_0 via pads
    GstPad *mux_sinkpad = gst_element_get_request_pad(streammux, "sink_0");
    GstPad *pre_srcpad  = gst_element_get_static_pad(pre_caps, "src");
    if (!mux_sinkpad || !pre_srcpad || gst_pad_link(pre_srcpad, mux_sinkpad) != GST_PAD_LINK_OK) {
        g_printerr("ERROR: Failed to link pre_caps -> streammux sink_0\n");
        if (pre_srcpad) gst_object_unref(pre_srcpad);
        if (mux_sinkpad) gst_object_unref(mux_sinkpad);
        return -1;
    }
    gst_object_unref(pre_srcpad);
    gst_object_unref(mux_sinkpad);

    // rest of pipeline
    if (!gst_element_link_many(streammux, pgie, post_nvconv, post_caps, nvosd, sink, NULL)) {
        g_printerr("ERROR: Failed to link streammux->pgie->post_nvconv->post_caps->nvosd->sink\n");
        return -1;
    }

    // probe on OSD sink to print detections
    GstPad *osd_sink_pad = gst_element_get_static_pad(nvosd, "sink");
    if (osd_sink_pad) {
        gst_pad_add_probe(osd_sink_pad, GST_PAD_PROBE_TYPE_BUFFER, osd_sink_pad_buffer_probe, NULL, NULL);
        gst_object_unref(osd_sink_pad);
    }

    g_print("Starting pipeline...\n\n");
    gst_element_set_state(pipeline, GST_STATE_PLAYING);
    g_main_loop_run(loop);

    g_print("\nCleaning up...\n");
    gst_element_set_state(pipeline, GST_STATE_NULL);
    gst_object_unref(GST_OBJECT(pipeline));
    if (bus_watch_id) g_source_remove(bus_watch_id);
    g_main_loop_unref(loop);
    return 0;
}
